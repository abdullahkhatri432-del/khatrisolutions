# --- Form delivery ---------------------------------------------------------
# By default the site builds with Netlify Forms enabled (see netlify.toml,
# VITE_NETLIFY_FORMS=true). Submissions are stored in the Netlify dashboard and
# emailed to site.contact.email through a submission notification.
#
# Local development does not read netlify.toml, so `npm run dev` keeps the
# WhatsApp / email handoff behaviour.

# Optional third-party endpoint that accepts a JSON POST. Takes precedence over
# Netlify Forms when set. Works with Formspree, Basin, Getform or your own API.
# The payload includes kind, name, business, email, phone, service, budget,
# timeline, description, contactMethod, conditional service details, and the
# formatted "message" text.
#
# Only put a public form endpoint here. Never add API secrets to a VITE_ variable.
VITE_FORM_ENDPOINT=

# Set automatically by netlify.toml during a Netlify build. Leave unset locally.
# VITE_NETLIFY_FORMS=true
