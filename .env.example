# --- Form delivery ---------------------------------------------------------
# The site is hosted on Render as a static site, which cannot store form
# submissions. Enquiries are delivered by a Google Apps Script Web App, which
# is already configured as the default in src/config/site.js.
#
# The Apps Script endpoint only accepts a "simple" CORS request, so
# src/lib/inquiry.js sends an application/x-www-form-urlencoded body with a
# single `payload` field containing the JSON string:
#
#   payload={"kind":"project-inquiry","name":"...","email":"..."}
#
# The script must reply with JSON: {"ok":true,"lead_id":"..."} on success, or
# {"ok":false,"error":"..."} on failure. Anything else is treated as a failure.
#
# The Apps Script source and its setup (OpenRouter, Vercel, sales email) live in
# apps-script.js and the "Apps Script automation" section of README.md.
#
# Netlify Forms support still exists but is opt-in: set VITE_NETLIFY_FORMS=true
# in a build that actually runs on Netlify. Do not set it on Render.

# Optional override for the Apps Script Web App URL. Leave empty to use the
# default endpoint configured in src/config/site.js.
#
# Only put a public form endpoint here. Never add API secrets to a VITE_ variable.
VITE_FORM_ENDPOINT=

# Opt-in Netlify Forms flag for a Netlify-hosted build. Leave unset on Render.
# VITE_NETLIFY_FORMS=true

# --- Studio Desk (local only) ---------------------------------------------
# The proposal helper runs on your machine with `npm run studio`. These values
# belong in .env.local, which is gitignored. None of them are sent to the
# browser, and Studio Desk has no send code.
#
# Google Sheet CSV export behind the form (share the sheet as "Anyone with the
# link - Viewer", or publish a tab as CSV). Use a dedicated export tab with
# only the fields the desk needs.
# LEADS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<sheet-id>/export?format=csv&gid=0
#
# Safer alternative: a local CSV export that you refresh yourself. Relative
# paths are resolved from the project root.
# LEADS_CSV_FILE=leads-export.csv
#
# OpenRouter key. Read by the local Node server only.
# OPENROUTER_API_KEY=sk-or-v1-...
#
# Free by default: $0 prompt and $0 completion, 1M context. Swap it if you
# prefer a paid model. Free endpoints have lower rate limits.
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#
# This model reasons before answering, so give it room for both the reasoning
# and the full proposal. Each draft is still free.
# STUDIO_AI_MAX_TOKENS=16000
# STUDIO_AI_TIMEOUT_MS=180000
#
# Generate a draft automatically when a new lead is pulled (default true).
# AUTO_DRAFT=true
#
# Failed drafts are not retried automatically; click Generate proposal instead.
# Studio Desk has no login and refuses a non-loopback host unless you opt in.
# STUDIO_ALLOW_REMOTE=false
#
# Optional local settings.
# STUDIO_PORT=4310
# STUDIO_REVIEWER=Abdullah Khatri
# STUDIO_DATA_DIR=.studio-data
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
